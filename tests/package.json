{
  "name": "do11y-tests",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:selectors": "vitest run --project selector-snapshots",
    "test:export": "vitest run --project export",
    "test:integration": "vitest run --project integration",
    "test:supabase": "vitest run --project export --reporter verbose export/supabase",
    "test:live-selectors": "TEST_LIVE=1 vitest run --project selector-snapshots selector-snapshots/live-sites",
    "test:all": "vitest run --reporter verbose",
    "test-integrations": "tsx test-integrations.ts",
    "test-e2e-live": "tsx test-e2e-live.ts",
    "test-live-sites": "tsx test-live-sites.ts",
    "test-queries": "tsx test-queries.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^3.1.0",
    "jsdom": "^26.0.0"
  }
}
