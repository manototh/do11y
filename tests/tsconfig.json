{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["vitest/globals"],
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@do11y/core": ["../src/core"],
      "@do11y/core/*": ["../src/core/*"],
      "@do11y/standalone": ["../src/standalone"],
      "@do11y/standalone/*": ["../src/standalone/*"],
      "@do11y/instrumentation": ["../src/instrumentation"],
      "@do11y/instrumentation/*": ["../src/instrumentation/*"]
    }
  },
  "include": ["."],
  "exclude": ["sites"]
}
